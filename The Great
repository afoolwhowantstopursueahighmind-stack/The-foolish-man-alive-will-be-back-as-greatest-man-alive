-- TAB LOADER
-- ======================================
local function loadTab(url, name)
    while true do
        local ok, err = pcall(function()
            loadstring(game:HttpGet(url))()
        end)
        if ok then
            print("[Hub] " .. name)
            break
        end
        task.wait(0.5)
    end
end

