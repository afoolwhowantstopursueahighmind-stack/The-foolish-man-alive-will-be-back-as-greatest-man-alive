-- ======================================
-- RENOA UI CLASS
-- ======================================
local RenoaUI = {}
RenoaUI.__index = RenoaUI

function RenoaUI.new(title, subtitle)
    local self = setmetatable({}, RenoaUI)
    self.Tabs = {}
    self.ActiveTab = nil
    self.Minimized = false
    self.Dragging = false
    self.DragStart = nil
    self.StartPos = nil
    
    -- ======================================
    -- SCREEN GUI
    -- ======================================
    self.ScreenGui = Instance.new("ScreenGui")
    self.ScreenGui.Name = "RenoaUI"
    self.ScreenGui.ResetOnSpawn = false
    self.ScreenGui.IgnoreGuiInset = true
    self.ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    self.ScreenGui.Parent = player:WaitForChild("PlayerGui")
    
    -- ======================================
    -- MAIN FRAME
    -- ======================================
    self.MainFrame = Instance.new("Frame")
    self.MainFrame.Name = "MainFrame"
    self.MainFrame.Size = CONFIG.WindowSize
    self.MainFrame.Position = UDim2.new(0.5, -210, 0.5, -160)
    self.MainFrame.BackgroundColor3 = CONFIG.Colors.Background
    self.MainFrame.BorderSizePixel = 0
    self.MainFrame.Active = true
    self.MainFrame.Parent = self.ScreenGui
    
    local mainCorner = Instance.new("UICorner")
    mainCorner.CornerRadius = UDim.new(0, 14)
    mainCorner.Parent = self.MainFrame
    
    local mainGradient = Instance.new("UIGradient")
    mainGradient.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, Color3.fromRGB(25, 25, 32)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(15, 15, 20)),
    }
    mainGradient.Rotation = 45
    mainGradient.Parent = self.MainFrame
    
    local mainStroke = Instance.new("UIStroke")
    mainStroke.Color = CONFIG.Colors.Accent
    mainStroke.Thickness = 1.5
    mainStroke.Transparency = 0.5
    mainStroke.Parent = self.MainFrame
    
    -- ======================================
    -- HEADER
    -- ======================================
    self.Header = Instance.new("Frame")
    self.Header.Name = "Header"
    self.Header.Size = UDim2.new(1, 0, 0, CONFIG.HeaderHeight)
    self.Header.BackgroundColor3 = CONFIG.Colors.Header
    self.Header.BorderSizePixel = 0
    self.Header.Parent = self.MainFrame
    
    local headerCorner = Instance.new("UICorner")
    headerCorner.CornerRadius = UDim.new(0, 14)
    headerCorner.Parent = self.Header
    
    local headerMask = Instance.new("Frame")
    headerMask.Size = UDim2.new(1, 0, 0, 12)
    headerMask.Position = UDim2.new(0, 0, 1, -12)
    headerMask.BackgroundColor3 = CONFIG.Colors.Header
    headerMask.BorderSizePixel = 0
    headerMask.Parent = self.Header
    
    local headerGradient = Instance.new("UIGradient")
    headerGradient.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, Color3.fromRGB(35, 35, 45)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(25, 25, 30)),
    }
    headerGradient.Rotation = 90
    headerGradient.Parent = self.Header
    
    local titleLabel = Instance.new("TextLabel")
    titleLabel.Size = UDim2.new(1, -100, 1, 0)
    titleLabel.Position = UDim2.new(0, 12, 0, 0)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Text = title or "Renoa Hub"
    titleLabel.TextColor3 = CONFIG.Colors.Text
    titleLabel.TextSize = 15
    titleLabel.Font = Enum.Font.GothamBlack
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.Parent = self.Header
    self.TitleLabel = titleLabel
    
    if subtitle then
        local subtitleLabel = Instance.new("TextLabel")
        subtitleLabel.Size = UDim2.new(1, -100, 0, 12)
        subtitleLabel.Position = UDim2.new(0, 12, 0, 18)
        subtitleLabel.BackgroundTransparency = 1
        subtitleLabel.Text = subtitle
        subtitleLabel.TextColor3 = CONFIG.Colors.TextDim
        subtitleLabel.TextSize = 10
        subtitleLabel.Font = Enum.Font.Gotham
        subtitleLabel.TextXAlignment = Enum.TextXAlignment.Left
        subtitleLabel.Parent = self.Header
    end
    
    -- Close Button
    local closeBtn = Instance.new("TextButton")
    closeBtn.Size = UDim2.new(0, 22, 0, 22)
    closeBtn.Position = UDim2.new(1, -28, 0, 5)
    closeBtn.BackgroundColor3 = CONFIG.Colors.Red
    closeBtn.Text = "X"
    closeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    closeBtn.TextSize = 12
    closeBtn.Font = Enum.Font.GothamBlack
    closeBtn.BorderSizePixel = 0
    closeBtn.Parent = self.Header
    
    local closeCorner = Instance.new("UICorner")
    closeCorner.CornerRadius = UDim.new(0, 6)
    closeCorner.Parent = closeBtn
    
    -- Minimize Button
    local minBtn = Instance.new("TextButton")
    minBtn.Size = UDim2.new(0, 22, 0, 22)
    minBtn.Position = UDim2.new(1, -54, 0, 5)
    minBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 90)
    minBtn.Text = "-"
    minBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    minBtn.TextSize = 16
    minBtn.Font = Enum.Font.GothamBlack
    minBtn.BorderSizePixel = 0
    minBtn.Parent = self.Header
    
    local minCorner = Instance.new("UICorner")
    minCorner.CornerRadius = UDim.new(0, 6)
    minCorner.Parent = minBtn
    
    -- ======================================
    -- DRAG SYSTEM
    -- ======================================
    self.Header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            self.Dragging = true
            self.DragStart = input.Position
            self.StartPos = self.MainFrame.Position
        elseif input.UserInputType == Enum.UserInputType.Touch then
            self.Dragging = true
            self.DragStart = input.Position
            self.StartPos = self.MainFrame.Position
        end
    end)
    
    self.Header.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            self.Dragging = false
        elseif input.UserInputType == Enum.UserInputType.Touch then
            self.Dragging = false
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if self.Dragging then
            if input.UserInputType == Enum.UserInputType.MouseMovement then
                local delta = input.Position - self.DragStart
                self.MainFrame.Position = UDim2.new(
                    self.StartPos.X.Scale, self.StartPos.X.Offset + delta.X,
                    self.StartPos.Y.Scale, self.StartPos.Y.Offset + delta.Y
                )
            elseif input.UserInputType == Enum.UserInputType.Touch then
                local delta = input.Position - self.DragStart
                self.MainFrame.Position = UDim2.new(
                    self.StartPos.X.Scale, self.StartPos.X.Offset + delta.X,
                    self.StartPos.Y.Scale, self.StartPos.Y.Offset + delta.Y
                )
            end
        end
    end)
    
    closeBtn.MouseButton1Click:Connect(function()
        self.ScreenGui.Enabled = false
    end)
    
    minBtn.MouseButton1Click:Connect(function()
        self.Minimized = not self.Minimized
        if self.Minimized then
            self.ContentFrame.Visible = false
            self.MainFrame.Size = CONFIG.MinimizedSize
        else
            self.ContentFrame.Visible = true
            self.MainFrame.Size = CONFIG.WindowSize
        end
    end)
    
    -- ======================================
    -- CONTENT FRAME
    -- ======================================
    self.ContentFrame = Instance.new("Frame")
    self.ContentFrame.Name = "Content"
    self.ContentFrame.Size = UDim2.new(1, 0, 1, -CONFIG.HeaderHeight)
    self.ContentFrame.Position = UDim2.new(0, 0, 0, CONFIG.HeaderHeight)
    self.ContentFrame.BackgroundTransparency = 1
    self.ContentFrame.Parent = self.MainFrame
    
    -- ======================================
    -- SIDEBAR
    -- ======================================
    self.Sidebar = Instance.new("ScrollingFrame")
    self.Sidebar.Name = "Sidebar"
    self.Sidebar.Size = UDim2.new(0, 110, 1, -8)
    self.Sidebar.Position = UDim2.new(0, 4, 0, 4)
    self.Sidebar.BackgroundColor3 = CONFIG.Colors.Sidebar
    self.Sidebar.BorderSizePixel = 0
    self.Sidebar.ScrollBarThickness = 3
    self.Sidebar.ScrollBarImageColor3 = CONFIG.Colors.Accent
    self.Sidebar.CanvasSize = UDim2.new(0, 0, 0, 0)
    self.Sidebar.AutomaticCanvasSize = Enum.AutomaticSize.Y
    self.Sidebar.Parent = self.ContentFrame
    
    local sidebarCorner = Instance.new("UICorner")
    sidebarCorner.CornerRadius = UDim.new(0, 12)
    sidebarCorner.Parent = self.Sidebar
    
    local sidebarLayout = Instance.new("UIListLayout")
    sidebarLayout.Padding = UDim.new(0, 4)
    sidebarLayout.SortOrder = Enum.SortOrder.LayoutOrder
    sidebarLayout.Parent = self.Sidebar
    
    local sidebarPad = Instance.new("UIPadding")
    sidebarPad.PaddingTop = UDim.new(0, 6)
    sidebarPad.PaddingLeft = UDim.new(0, 6)
    sidebarPad.PaddingRight = UDim.new(0, 6)
    sidebarPad.PaddingBottom = UDim.new(0, 6)
    sidebarPad.Parent = self.Sidebar
    
    -- ======================================
    -- TAB SCROLL
    -- ======================================
    self.TabScroll = Instance.new("ScrollingFrame")
    self.TabScroll.Name = "TabScroll"
    self.TabScroll.Size = UDim2.new(1, -122, 1, -8)
    self.TabScroll.Position = UDim2.new(0, 118, 0, 4)
    self.TabScroll.BackgroundTransparency = 1
    self.TabScroll.BorderSizePixel = 0
    self.TabScroll.ScrollBarThickness = 4
    self.TabScroll.ScrollBarImageColor3 = CONFIG.Colors.Accent
    self.TabScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
    self.TabScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    self.TabScroll.Parent = self.ContentFrame
    
    local tabLayout = Instance.new("UIListLayout")
    tabLayout.Padding = UDim.new(0, 6)
    tabLayout.SortOrder = Enum.SortOrder.LayoutOrder
    tabLayout.Parent = self.TabScroll
    
    local tabPad = Instance.new("UIPadding")
    tabPad.PaddingTop = UDim.new(0, 4)
    tabPad.PaddingLeft = UDim.new(0, 4)
    tabPad.PaddingRight = UDim.new(0, 4)
    tabPad.PaddingBottom = UDim.new(0, 4)
    tabPad.Parent = self.TabScroll
    
    return self
end

-- ======================================
-- CREATE TAB (WITH PROXY METHODS)
-- ======================================
function RenoaUI:CreateTab(name, icon)
    local window = self
    local tab = {
        Name = name,
        Window = window,
        Elements = {},
    }
    
    -- Tab Button
    local button = Instance.new("TextButton")
    button.Name = "Tab_" .. name
    button.Size = UDim2.new(1, -6, 0, 30)
    button.BackgroundColor3 = CONFIG.Colors.Element
    button.Text = name
    button.TextColor3 = CONFIG.Colors.Text
    button.TextSize = 12
    button.Font = Enum.Font.GothamBold
    button.BorderSizePixel = 0
    button.AutoButtonColor = false
    button.Parent = window.Sidebar
    
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 10)
    btnCorner.Parent = button
    
    local btnGlow = Instance.new("UIStroke")
    btnGlow.Color = CONFIG.Colors.AccentGlow
    btnGlow.Thickness = 1
    btnGlow.Transparency = 1
    btnGlow.Parent = button
    
    -- Tab Content
    local content = Instance.new("Frame")
    content.Name = "Content_" .. name
    content.Size = UDim2.new(1, 0, 0, 0)
    content.BackgroundTransparency = 1
    content.AutomaticSize = Enum.AutomaticSize.Y
    content.Visible = false
    content.Parent = window.TabScroll
    
    local contentLayout = Instance.new("UIListLayout")
    contentLayout.Padding = UDim.new(0, 6)
    contentLayout.SortOrder = Enum.SortOrder.LayoutOrder
    contentLayout.Parent = content
    
    tab.Button = button
    tab.Content = content
    tab.Glow = btnGlow
    
    -- Click Handler
    button.MouseButton1Click:Connect(function()
        for _, t in ipairs(window.Tabs) do
            t.Button.BackgroundColor3 = CONFIG.Colors.Element
            t.Button.TextColor3 = CONFIG.Colors.Text
            t.Content.Visible = false
            if t.Glow then
                t.Glow.Transparency = 1
            end
        end
        
        button.BackgroundColor3 = CONFIG.Colors.Accent
        button.TextColor3 = Color3.fromRGB(255, 255, 255)
        content.Visible = true
        btnGlow.Transparency = 0.3
        window.ActiveTab = tab
    end)
    
    -- Hover
    button.MouseEnter:Connect(function()
        if window.ActiveTab ~= tab then
            button.BackgroundColor3 = CONFIG.Colors.ElementHover
        end
    end)
    
    button.MouseLeave:Connect(function()
        if window.ActiveTab ~= tab then
            button.BackgroundColor3 = CONFIG.Colors.Element
        end
    end)
    
    -- Add to tabs
    table.insert(window.Tabs, tab)
    
    -- Auto-select first tab
    if #window.Tabs == 1 then
        window.ActiveTab = tab
        button.BackgroundColor3 = CONFIG.Colors.Accent
        button.TextColor3 = Color3.fromRGB(255, 255, 255)
        content.Visible = true
        btnGlow.Transparency = 0.3
    end
    
    -- ======================================
    -- PROXY METHODS (Add content to THIS tab)
    -- ======================================
    local function withActiveTab(func)
        return function(...)
            local oldActive = window.ActiveTab
            window.ActiveTab = tab
            local result = func(...)
            window.ActiveTab = oldActive
            return result
        end
    end
    
    tab.CreateSection = withActiveTab(function(title)
        return window:CreateSection(title)
    end)
    
    tab.CreateLabel = withActiveTab(function(text)
        return window:CreateLabel(text)
    end)
    
    tab.CreateButton = withActiveTab(function(config)
        return window:CreateButton(config)
    end)
    
    tab.CreateToggle = withActiveTab(function(config)
        return window:CreateToggle(config)
    end)
    
    tab.CreateInput = withActiveTab(function(config)
        return window:CreateInput(config)
    end)
    
    tab.CreateDropdown = withActiveTab(function(config)
        return window:CreateDropdown(config)
    end)
    
    return tab
end

-- ======================================
-- CREATE SECTION
-- ======================================
function RenoaUI:CreateSection(title)
    local tab = self.ActiveTab
    if not tab then return end
    
    local section = Instance.new("TextLabel")
    section.Name = "Section_" .. title
    section.Size = UDim2.new(1, 0, 0, 20)
    section.BackgroundTransparency = 1
    section.Text = title
    section.TextColor3 = CONFIG.Colors.MoonlightBlue
    section.TextSize = 13
    section.Font = Enum.Font.GothamBlack
    section.TextXAlignment = Enum.TextXAlignment.Left
    section.Parent = tab.Content
    
    return section
end

-- ======================================
-- CREATE LABEL
-- ======================================
function RenoaUI:CreateLabel(text)
    local tab = self.ActiveTab
    if not tab then return end
    
    local label = Instance.new("TextLabel")
    label.Name = "Label"
    label.Size = UDim2.new(1, 0, 0, 16)
    label.BackgroundTransparency = 1
