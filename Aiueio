-- ======================================
-- CREATE DROPDOWN
-- ======================================
function RenoaUI:CreateDropdown(config)
    local tab = self.ActiveTab
    if not tab then return end
    
    local multiple = config.MultipleOptions or false
    local selected = {}
    
    if multiple then
        if type(config.CurrentOption) == "table" then
            for _, v in ipairs(config.CurrentOption) do
                selected[v] = true
            end
        elseif config.CurrentOption then
            selected[config.CurrentOption] = true
        end
    else
        if type(config.CurrentOption) == "table" then
            selected[config.CurrentOption[1]] = true
        else
            selected[config.CurrentOption] = true
        end
    end
    
    local frame = Instance.new("Frame")
    frame.Name = "Dropdown_" .. (config.Name or "Dropdown")
    frame.Size = UDim2.new(1, 0, 0, 30)
    frame.BackgroundColor3 = CONFIG.Colors.Element
    frame.BorderSizePixel = 0
    frame.ClipsDescendants = false
    frame.Parent = tab.Content
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = frame
    
    local header = Instance.new("TextButton")
    header.Size = UDim2.new(1, 0, 1, 0)
    header.BackgroundTransparency = 1
    header.Text = ""
    header.Parent = frame
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -110, 1, 0)
    label.Position = UDim2.new(0, 12, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = config.Name or "Dropdown"
    label.TextColor3 = CONFIG.Colors.Text
    label.TextSize = 12
    label.Font = Enum.Font.GothamMedium
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = header
    
    local valueLabel = Instance.new("TextLabel")
    valueLabel.Size = UDim2.new(0, 95, 1, 0)
    valueLabel.Position = UDim2.new(1, -100, 0, 0)
    valueLabel.BackgroundTransparency = 1
    valueLabel.TextColor3 = CONFIG.Colors.MoonlightBlue
    valueLabel.TextSize = 11
    valueLabel.Font = Enum.Font.GothamBold
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right
    valueLabel.Parent = header
    
    local optionsFrame = Instance.new("ScrollingFrame")
    optionsFrame.Size = UDim2.new(1, 0, 0, 0)
    optionsFrame.Position = UDim2.new(0, 0, 1, 5)
    optionsFrame.BackgroundColor3 = CONFIG.Colors.Background
    optionsFrame.BorderSizePixel = 0
    optionsFrame.ScrollBarThickness = 3
    optionsFrame.ScrollBarImageColor3 = CONFIG.Colors.Accent
    optionsFrame.Visible = false
    optionsFrame.ZIndex = 50
    optionsFrame.Parent = frame
    
    local optCorner = Instance.new("UICorner")
    optCorner.CornerRadius = UDim.new(0, 10)
    optCorner.Parent = optionsFrame
    
    local optStroke = Instance.new("UIStroke")
    optStroke.Color = CONFIG.Colors.Accent
    optStroke.Thickness = 1
    optStroke.Transparency = 0.5
    optStroke.Parent = optionsFrame
    
    local optLayout = Instance.new("UIListLayout")
    optLayout.Padding = UDim.new(0, 3)
    optLayout.SortOrder = Enum.SortOrder.LayoutOrder
    optLayout.Parent = optionsFrame
    
    local optPad = Instance.new("UIPadding")
    optPad.PaddingTop = UDim.new(0, 4)
    optPad.PaddingLeft = UDim.new(0, 4)
    optPad.PaddingRight = UDim.new(0, 4)
    optPad.PaddingBottom = UDim.new(0, 4)
    optPad.Parent = optionsFrame
    
    local isOpen = false
    
    local function updateValueLabel()
        local list = {}
        for k, v in pairs(selected) do
            if v then
                table.insert(list, k)
            end
        end
        
        if #list == 0 then
            valueLabel.Text = "None"
        elseif #list == 1 then
            valueLabel.Text = list[1]
        elseif #list <= 2 then
            valueLabel.Text = table.concat(list, ", ")
        else
            valueLabel.Text = list[1] .. " +" .. (#list - 1)
        end
    end
    
    local function fireCallback()
        local list = {}
        for k, v in pairs(selected) do
            if v then
                table.insert(list, k)
            end
        end
        
        if config.Callback then
            if multiple then
                pcall(config.Callback, list)
            else
                pcall(config.Callback, list[1])
            end
        end
    end
    
    for i, option in ipairs(config.Options or {}) do
        local optBtn = Instance.new("TextButton")
        optBtn.Size = UDim2.new(1, -4, 0, 24)
        optBtn.BackgroundColor3 = selected[option] and CONFIG.Colors.Accent or CONFIG.Colors.Element
        optBtn.Text = option
        optBtn.TextColor3 = CONFIG.Colors.Text
        optBtn.TextSize = 11
        optBtn.Font = Enum.Font.GothamMedium
        optBtn.BorderSizePixel = 0
        optBtn.ZIndex = 51
        optBtn.Parent = optionsFrame
        
        local optBtnCorner = Instance.new("UICorner")
        optBtnCorner.CornerRadius = UDim.new(0, 8)
        optBtnCorner.Parent = optBtn
        
        optBtn.MouseButton1Click:Connect(function()
            if multiple then
                selected[option] = not selected[option]
            else
                for k, _ in pairs(selected) do
                    selected[k] = false
                end
                selected[option] = true
                isOpen = false
                optionsFrame.Visible = false
                optionsFrame.Size = UDim2.new(1, 0, 0, 0)
            end
            
            if selected[option] then
                optBtn.BackgroundColor3 = CONFIG.Colors.Accent
            else
                optBtn.BackgroundColor3 = CONFIG.Colors.Element
            end
            
            updateValueLabel()
            fireCallback()
        end)
    end
    
    updateValueLabel()
    
    header.MouseButton1Click:Connect(function()
        isOpen = not isOpen
        if isOpen then
            local optHeight = math.min(#(config.Options or {}) * 28 + 10, 200)
            optionsFrame.Visible = true
            optionsFrame.Size = UDim2.new(1, 0, 0, optHeight)
            optionsFrame.CanvasSize = UDim2.new(0, 0, 0, #(config.Options or {}) * 28 + 10)
        else
            optionsFrame.Visible = false
            optionsFrame.Size = UDim2.new(1, 0, 0, 0)
        end
    end)
    
    return frame
end

-- ======================================
-- DESTROY
-- ======================================
function RenoaUI:Destroy()
    if self.ScreenGui then
        self.ScreenGui:Destroy()
    end
end

-- ======================================
-- RETURN
-- ======================================
return RenoaUI
